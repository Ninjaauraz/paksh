# --- secrets: NEVER commit these ---
.env
.env.*
*.key
secrets.*
# AI provider keys - paste real keys ONLY in ai_keys.env (local, never committed).
# ai_keys.example.env is the safe, keyless template that IS committed.
ai_keys.env

# Phase 30C-J: bounded local provider-health cache (ai_providers.py). Advisory
# runtime state only (health/success/failure counts) - never prompts, source
# text, summaries, or credentials. Machine-local, not shared history.
.provider_health.json
*.keys.env

# --- local database + caches (regenerated; never publish) ---
paksh.db
paksh.db-journal
paksh.db-wal
paksh.db-shm

# --- logs ---
refresh_log.txt
*.log

# --- python ---
__pycache__/
*.pyc
.venv/
venv/

# export_static.py builds into these scratch dirs before swapping the finished result
# into _site/ (see _publish_build) - transient, never meant to be committed.
_site.building/
_site.old/

# NOTE: _site/ IS committed on purpose - it's what Vercel serves.
*.db
*.db.bak
*.db-journal

# --- database backups, ANY variant/suffix (huge - a stray one breaks the push) ---
# catches paksh.db.bak, paksh.db.bak2, paksh.db.bak.20260718_175451, paksh.db-wal, etc.
paksh.db*
*.db.bak*
*.bak

# --- Phase 2.0A migration checkpoint (ids/counts/status only, never credentials) ---
.migration_checkpoint.json

# --- pipeline runtime: interlock + scheduled-task logs ---
.pipeline.lock
reframe_log.txt
autopush_log.txt
backup_log.txt
live_log.txt
# root vendor/ is a LOCAL build tool (babel.min.js) - ignored. Anchored to root with a
# leading slash so it does NOT also ignore static/vendor/ (self-hosted React, which MUST
# ship). Without the slash, static/vendor/react*.js were dropped -> blank page on deploy.
/vendor/

# internal Redstocks market-signal exports - never publish/commit
signals/

# OG share-card local preview scratch
_og_preview/
