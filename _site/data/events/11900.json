r independent stand"}, {"source": "The Hindu", "owner": "The Hindu Group", "lean": "left", "language": "en", "url": "https://www.thehindu.com/news/national/jharkhand/bjp-stages-protest-on-jharkhand-assembly-premises-over-job-exam-irregularities/article71316537.ece", "headline": "BJP stages protest on Jharkhand Assembly premises over job exam 'irregularities'"}, {"source": "The Hindu", "owner": "The Hindu Group", "lean": "left", "language": "en", "url": "https://www.thehindu.com/news/national/jharkhand/jharkhand-exam-irregularities-student-protest-youth-unemployment-updates-on-august-7-2026/article71316373.ece", "headline": "Jharkhand job exam stir enters 14th day, protester on hunger strike taken to hospital"}, {"source": "The Times of India", "owner": "Times Group", "lean": "center", "language": "en", "url": "https://timesofindia.indiatimes.com/city/ranchi/jharkhand-jpsc-jssc-stir-student-shifted-to-hospital-after-health-worsens-as-agitation-enters-day-14/articleshow/133022748.cms", "headline": "Jharkhand protest day 14: Student shifted to hospital after health worsens"}, {"source": "The Times of India", "owner": "Times Group", "lean": "center", "language": "en", "url": "https://timesofindia.indiatimes.com/city/ranchi/we-are-children-not-terrorists-students-on-hunger-strike-urge-jharkhand-cm-to-meet-protesters/articleshow/133021793.cms", "headline": "'We are children, not terrorists': Jharkhand students on hunger strike"}, {"source": "The Times of India", "owner": "Times Group", "lean": "center", "language": "en", "url": "https://timesofindia.indiatimes.com/india/bjp-mlas-storm-well-disrupt-jharkhand-assembly-over-exam-irregularities/articleshow/133025057.cms", "headline": "BJP MLAs storm well, disrupt Jharkhand assembly over exam irregularities"}, {"source": "Republic World", "owner": "Republic World", "lean": "right", "language": "en", "url": "https://news.google.?oc=5", "headline": "Jharkhand Exam Row: Protest Enters Day 14, Hunger Strike Day 6, as BJP Demands T