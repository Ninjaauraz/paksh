# ============================================================================
# Paksh keys - TEMPLATE.  Copy this file to  ai_keys.env  and paste real keys.
# ai_keys.env is GITIGNORED (never committed/pushed). Keep real keys ONLY there.
# One KEY=value per line, no quotes, no spaces. Lines starting with # are ignored.
#
# Check LLM pool:   py ai_providers.py            (then --ping to test)
# Check CF embed:   py cluster.py --verify-cf
# ============================================================================

# ---- LLM summary/framing pool (PAKSH_LLM_BACKEND=pool) ----------------------
# Groq - free, fastest.  Get a key: https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras - free, very fast.  Get a key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Gemini - optional; you may already have this in your environment.
# Get a key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# --- Add more as you add providers in ai_providers.py (match the key_env name) ---
# SAMBANOVA_API_KEY=
# OPENROUTER_API_KEY=

# ---- Cloudflare Workers AI: OPT-IN faster embeddings (same bge-m3, GPU-hosted) ---
# Only needed if you run  PAKSH_BACKEND=cloudflare  for clustering embeddings.
# Account ID: Cloudflare dashboard -> Workers & Pages (right sidebar).
# API token : My Profile -> API Tokens -> Create Token -> "Workers AI" template.
# VERIFY it matches your Ollama vectors first:  py cluster.py --verify-cf
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
